# Environment
# Default for local development. For test.shuushuu.com exposed on internet, set ENVIRONMENT=production and DEBUG=false for HTTPS support and security.
ENVIRONMENT=development
DEBUG=true

# Host identity — one .env per host; these mark which stack this host runs.
# The Makefile guards (check-env-test/check-env-prod) assert them before any
# stack-mutating target, and compose interpolates them (test overlay:
# NGINX_HOST=${DOMAIN}; prod overlay requires NGINX_HOST and DOCKER_GID,
# the latter rendered by ansible from `getent group docker`).
# Test host: DOMAIN=test.shuushuu.com
# Prod host: NGINX_HOST=e-shuushuu.net
DOMAIN=localhost
#NGINX_HOST=e-shuushuu.net

# Database (Postgres)
# Used by docker-compose for the Postgres container. Pin the image deliberately;
# prod's native DB tier runs Postgres 18.
POSTGRES_IMAGE=postgres:18.6
POSTGRES_DB=shuushuu
POSTGRES_USER=shuushuu
POSTGRES_PASSWORD=change_this_password
# POSTGRES_SHARED_BUFFERS=2GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=4GB

# Database URL (used by the application when run on the host; the compose
# api/arq containers build their own from the POSTGRES_* values above)
DATABASE_URL=postgresql+asyncpg://shuushuu:change_this_password@localhost:5432/shuushuu

# Redis
REDIS_URL=redis://redis:6379/0

# ARQ Task Queue
ARQ_REDIS_URL=redis://redis:6379/1
ARQ_MAX_TRIES=3
ARQ_KEEP_RESULT=3600

# Security (MUST CHANGE FOR PRODUCTION!)
# CRITICAL: Generate a secure random secret key! Never use the default!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long-DO-NOT-COMMIT-REAL-KEY

# JWT signing algorithm used for tokens
ALGORITHM=HS256

# Task Queue
TASK_QUEUE_TYPE=background

# IQDB
IQDB_HOST=iqdb
IQDB_PORT=5588

# CORS - For internet-exposed test.shuushuu.com, set to HTTPS domain
CORS_ORIGINS=https://test.shuushuu.com

# Storage
STORAGE_PATH=/shuushuu/images

# Dev only: host port of the Vite dev server nginx proxies '/' to. Defaults to
# 5173; set it when that port is taken, and match it with DEV_PORT in the
# frontend repo's .env.
# FRONTEND_DEV_PORT=5173

# Dev only: xdist workers for `make pytest`. Defaults to `auto` (one per core).
# Cap it on a host that is also running a dev stack — each worker adds its own
# connections and temp tables on top, and overshooting invites the OOM killer.
# PYTEST_WORKERS=auto

# S3 Configuration (optional, for production)
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Email Configuration (optional)
# Common configurations:
#   - Port 587 + STARTTLS (default): SMTP_TLS=false, SMTP_STARTTLS=true
#   - Port 465 + implicit TLS: SMTP_TLS=true, SMTP_STARTTLS=false
#   - Localhost (no encryption): SMTP_TLS=false, SMTP_STARTTLS=false
# Note: SMTP_TLS and SMTP_STARTTLS are mutually exclusive
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_TLS=false
# SMTP_STARTTLS=true
# SMTP_FROM_EMAIL=noreply@e-shuushuu.net
# SMTP_FROM_NAME=Shuushuu

# Frontend URL (for email verification links, etc.)
FRONTEND_URL=https://test.shuushuu.com

# Image Base URL - CRITICAL for public domains
# Must match exactly what users see in their browser
# Development: http://localhost:3000 or http://localhost:8000
# Production (internet-exposed): https://test.shuushuu.com (HTTPS required!)
IMAGE_BASE_URL=https://test.shuushuu.com

# Test Database (run-tests.sh sets this itself; set it only to point pytest
# at a different Postgres server)
# TEST_DATABASE_URL=postgresql+asyncpg://shuushuu:change_this_password@localhost:5432/shuushuu_pytest

# Grafana admin password (centralized logging UI). Only used by docker-compose.prod.yml.
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# ML tag suggestions (off by default; needs ONNX model files — see docs/ml-tag-suggestions.md)
ML_TAG_SUGGESTIONS_ENABLED=false
ML_MODELS_PATH=ml_models
ML_MODEL_NAME=wd-swinv2-tagger-v3
ML_MIN_CONFIDENCE=0.35

# Character suggestions disabled pending tag-mapping quality work (cross-franchise
# collisions). Raw character predictions still accumulate; re-enable + ml_remap to backfill.
ML_CHARACTER_SUGGESTIONS_ENABLED=false

# Per-image pending-suggestion thumbnail badge (too much visual noise; disabled for now).
# Off = GET /images skips the count query and the badge does not render.
ML_SUGGESTION_BADGE_ENABLED=false
